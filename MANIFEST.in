include *.md
include *.rst
include *.sh
include *.bat
include *.ps1
include *.py
include *.toml
include proj
recursive-include src *.html
recursive-include src *.pxd
recursive-include src *.pyx
recursive-include src *.pyi
recursive-include src *.h
recursive-include src *.inc
recursive-include src *.py
recursive-include src *.md
recursive-include src *.pxi
recursive-include src *.c
recursive-include src py.typed
graft rpyutils
graft c-questdb-client
prune c-questdb-client/src/tests/json_tests.rs
prune c-questdb-client/build
# The grafts above take every file on disk, tracked or not, so this list
# strips what a working checkout accumulates. The sdist then matches one
# built from a fresh clone of the release commit.
#
# Cargo build output at any depth, including the test crates under
# c-questdb-client/system_test/. No tracked path has a target/ component.
prune **/target
prune **/__pycache__
# Agent tooling and its local state; not needed to build.
prune c-questdb-client/.claude
# The submodule's .git is a gitdir pointer file in a submodule checkout and
# a directory in a standalone clone, so both forms are dropped.
prune c-questdb-client/.git
exclude c-questdb-client/.git
# The QuestDB server repo, a nested submodule used only by system tests.
prune c-questdb-client/questdb
# Untracked (gitignored in c-questdb-client); cargo writes it on a local
# build of the crate. The tracked Cargo.lock files elsewhere stay in.
exclude c-questdb-client/questdb-rs/Cargo.lock
